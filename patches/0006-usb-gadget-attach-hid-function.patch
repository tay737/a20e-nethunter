diff --git a/drivers/usb/gadget/configfs.c b/drivers/usb/gadget/configfs.c
index bbcf45b3..f1fbbaf4 100755
--- a/drivers/usb/gadget/configfs.c
+++ b/drivers/usb/gadget/configfs.c
@@ -743,18 +743,28 @@ static int config_usb_cfg_link(
 			i = 0;
 			list_for_each_entry(cn, &cfg->string_list, list) {
 				i++;
-				if (strcmp(cn->configuration, "Conf 1")!= 0) {			
-					if (strcmp(cn->configuration, "adb") == 0) {				
+				if (strcmp(cn->configuration, "Conf 1")!= 0) {
+					/*
+					 * Stock code treats any config whose string is not
+					 * "Conf 1" as GSI/adb mode and returns early, so a
+					 * function linked while the config string reads
+					 * "adb" is never allocated and silently vanishes.
+					 * Let the hid instance through to the normal linking
+					 * path; everything else takes the stock early return,
+					 * so boot-time behaviour is unchanged.
+					 */
+					if (strcmp(cn->configuration, "adb") == 0 &&
+					    strcmp(usb_func_ci->ci_namebuf, "hid.0") != 0) {
 						list_for_each_entry_safe(f, tmp, &gi->linked_func, list) {
 							if (strcmp(f->name , "adb") == 0) {
 								printk("usb: %s: GSI adb works(%s)\n",__func__, f->name);
 								list_move_tail(&f->list, &cfg->func_list);
 							}
 						}
+						gi->gsi_boot=1;
+						ret = 0;
+						goto out;
 					}
-					gi->gsi_boot=1;
-					ret = 0;
-					goto out;
 				} else {
 					gi->gsi_boot=0;
 				}
@@ -774,7 +784,22 @@ static int config_usb_cfg_link(
 	}
 
 #ifdef CONFIG_USB_CONFIGFS_UEVENT
-	list_add_tail(&f->list, &gi->linked_func);
+	/*
+	 * Samsung parks every function here and only the adb path ever moves one
+	 * into a configuration, so a configfs-linked f_hid is allocated and then
+	 * stranded: the bind never reaches hidg_bind() and /dev/hidg0 never
+	 * appears.
+	 *
+	 * Attach HID straight to the configuration it was linked into, which is
+	 * what userspace asks for when it builds a hid-only gadget. Every other
+	 * function keeps the stock parked behaviour: at boot init links a dozen
+	 * of them, and dragging those into the composite changes how the device
+	 * enumerates (it does not boot).
+	 */
+	if (f->name && strcmp(f->name, "hid") == 0)
+		list_add_tail(&f->list, &cfg->func_list);
+	else
+		list_add_tail(&f->list, &gi->linked_func);
 #else
 	/* stash the function until we bind it to the gadget */
 	list_add_tail(&f->list, &cfg->func_list);
