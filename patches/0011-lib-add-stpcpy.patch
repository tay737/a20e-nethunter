diff --git a/lib/stpcpy.c b/lib/stpcpy.c
new file mode 100644
index 00000000..43f2901b
--- /dev/null
+++ b/lib/stpcpy.c
@@ -0,0 +1,19 @@
+/*
+ * stpcpy - copy a string returning a pointer to its end
+ *
+ * Newer compilers turn "strcpy(dst, src) + strlen(src)" style code into
+ * stpcpy() calls, which this 4.4 tree does not provide. Supply it so the
+ * kernel links with clang 23 like it did with the vendor gcc.
+ */
+
+#include <linux/string.h>
+#include <linux/export.h>
+
+char *stpcpy(char *dest, const char *src)
+{
+	size_t len = strlen(src);
+
+	memcpy(dest, src, len + 1);
+	return dest + len;
+}
+EXPORT_SYMBOL(stpcpy);
