diff --git a/drivers/usb/gadget/configfs.c b/drivers/usb/gadget/configfs.c
index bbcf45b3..e75b437c 100755
--- a/drivers/usb/gadget/configfs.c
+++ b/drivers/usb/gadget/configfs.c
@@ -1648,6 +1648,38 @@ static int configfs_composite_bind(struct usb_gadget *gadget,
 	}
 
 
+#ifdef CONFIG_USB_CONFIGFS_UEVENT
+	/*
+	 * Samsung parks every configfs-linked function on gi->linked_func and,
+	 * in stock code, only the hardcoded "adb" path ever moves one into a
+	 * configuration. Anything else (f_hid, for example) never reaches
+	 * usb_add_function(), so a hid-only configuration binds empty
+	 * ("needs at least one function", -EINVAL) and /dev/hidg0 never appears.
+	 *
+	 * Only fall back to the parked list when the configuration would
+	 * otherwise be empty: that is exactly the "nothing but the function the
+	 * user linked" case. When stock code already attached something (at boot
+	 * it attaches adb while the remaining init links stay parked) every
+	 * parked function must stay out, otherwise the composite gains a dozen
+	 * functions the platform never intended to expose.
+	 */
+	if (!list_empty(&gi->linked_func)) {
+		struct usb_configuration *cfg_c;
+		struct config_usb_cfg *cf;
+		struct usb_function *sf, *stmp;
+
+		cfg_c = list_first_entry_or_null(&gi->cdev.configs,
+						 struct usb_configuration, list);
+		if (cfg_c) {
+			cf = container_of(cfg_c, struct config_usb_cfg, c);
+			if (list_empty(&cf->func_list)) {
+				list_for_each_entry_safe(sf, stmp, &gi->linked_func, list)
+					list_move_tail(&sf->list, &cf->func_list);
+			}
+		}
+	}
+#endif
+
 	list_for_each_entry(c, &gi->cdev.configs, list) {
 		struct config_usb_cfg *cfg;
 
